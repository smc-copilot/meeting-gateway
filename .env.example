# This file deliberately contains no working secret. Prefer: python -m app.cli generate-env ...
ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://meeting:REPLACE_WITH_PRIVATE_PASSWORD@postgres:5432/meeting
POSTGRES_PASSWORD=
# Primary mode: tencent_oauth (client starts authorize URL; scan establishes local identity).
# account_login remains only for legacy tooling and is disabled at the HTTP API.
IDENTITY_MODE=tencent_oauth
ACCOUNT_LOGIN_URL=
ACCOUNT_LOGIN_ALLOW_PRIVATE_HTTP=false
MEETING_COMPONENT_ID=meeting-gateway
MEETING_ORG_ID=
MEETING_BOOTSTRAP_ADMIN_USER_IDS=[]
AUTH_SESSION_TTL_SECONDS=900
AUTH_ADMIN_FRESH_SECONDS=300
TENCENT_MEETING_AUTH_MODE=oauth
TENCENT_MEETING_CORP_ID=
TENCENT_MEETING_APP_ID=
TENCENT_MEETING_APP_SECRET=
TENCENT_MEETING_ALLOWED_OPEN_CORP_IDS=[]
# Optional; only used by authenticated portal oauth_start, NOT the public scan bootstrap flow.
# Public bootstrap always returns browser to {PUBLIC_BASE_URL}/oauth/tencent/complete.
TENCENT_MEETING_OAUTH_RETURN_URIS=[]
# Webhook aliases also accepted: TENCENT_MEETING_WEBHOOK_ENCODING_AES_KEY and TENCENT_MEETING_WEBHOOK_TOKEN
TENCENT_MEETING_WEBHOOK_NAME=
TENCENT_MEETING_WEBHOOK_EncodingAESKey=
TENCENT_MEETING_WEBHOOK_Token=
TENCENT_MEETING_WEBHOOK_URL=
METRICS_TOKEN=
KEYRING_JSON={}
ACTIVE_KEY_ID=v1
PUBLIC_BASE_URL=https://meeting-gateway.example.invalid
PORTAL_BASE_URL=https://console.example.invalid
ALLOWED_HOSTS=["meeting-gateway.example.invalid","localhost","127.0.0.1"]
CORS_ORIGINS=["https://console.example.invalid"]
MCP_ORIGINS=["https://console.example.invalid"]
# Exact observed Tencent media hosts only; no wildcard, arbitrary URL or redirect proxy.
MEDIA_ALLOWED_HOSTS=[]
NOTIFICATION_ALLOWED_HOSTS=[]
NOTIFICATION_ALLOWED_NETWORKS=[]
STORAGE_PATH=/data/nodeskclaw-meeting/private
MEETING_ENABLED=true
MEETING_MCP_ENABLED=false
MEETING_CREATE_ENABLED=false
MEETING_CORP_SYNC_ENABLED=false
MEETING_MEDIA_DOWNLOAD_ENABLED=false
